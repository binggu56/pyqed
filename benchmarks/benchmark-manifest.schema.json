{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyqed.org/schemas/benchmark-manifest-1.0.json",
  "title": "PyQED benchmark result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "generated_at",
    "software",
    "environment",
    "workload",
    "execution",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pyqed_version", "git_commit", "git_dirty", "python_version", "dependencies"],
      "properties": {
        "pyqed_version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_dirty": {"type": "boolean"},
        "python_version": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "cpu", "logical_cores", "memory_bytes", "blas", "threads"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "logical_cores": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "blas": {"type": "string", "minLength": 1},
        "threads": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "method", "system", "parameters"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "system": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "working_directory", "warmups", "repeats"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "working_directory": {"type": "string", "minLength": 1},
        "warmups": {"type": "integer", "minimum": 0},
        "repeats": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "statistic"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "statistic": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "quantity", "tolerance", "observed_difference", "passed"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0},
        "observed_difference": {"type": "number", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string", "enum": ["input", "raw_output", "processed_output", "figure"]}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
