include HISTORY.rst
include LICENSE
include README.rst
include pyproject.toml
include setup.py
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include GOVERNANCE.md
include ROADMAP.md
include SECURITY.md
include SUPPORT.md
include THIRD_PARTY_NOTICES.md

include examples/quickstart.py

recursive-include pyqed/qchem/basis_set *.gbs *.txt
