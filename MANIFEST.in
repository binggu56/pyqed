exclude pyqed/gw/dmft.py
exclude pyqed/integral.py
exclude pyqed/models/ShinMetiuTBE.py
exclude pyqed/mps/results.py
exclude pyqed/namd/eckart.py
exclude pyqed/namd/gmat.py
exclude pyqed/qchem/dvr/sd.py
