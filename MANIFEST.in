include HISTORY.rst
include LICENSE
include README.rst
include pyproject.toml
include setup.py
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include GOVERNANCE.md
include ROADMAP.md
include SECURITY.md
include SUPPORT.md

include examples/quickstart.py

recursive-include pyqed/qchem/basis_set *.gbs *.txt
recursive-include pyqed/qchem/H2 *.in

include pyqed/_dop853.hpp
include pyqed/heom/_heom_cpp.cpp
include pyqed/mps/nonabelian/_su2_kernel.c
include pyqed/mps/nonabelian/_su2_kernel.pyx
